{
	"info": {
		"name": "Employee Service API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Generar Token",
			"request": {
				"method": "POST",
				"url": {
					"raw": "http://localhost:3307/auth/generate-test-token",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3307",
					"path": ["auth", "generate-test-token"]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				]
			}
		},
		{
			"name": "Crear Empleado",
			"request": {
				"method": "POST",
				"url": {
					"raw": "http://localhost:3307/employees",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3307",
					"path": ["employees"]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer <tu_token>"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Juan Pérez\",\n    \"documento\": \"123456789\",\n    \"fecha_ingreso\": \"2025-11-14\",\n    \"salario\": 50000.00,\n    \"nickname\": \"jperez\",\n    \"password\": \"password123\"\n}"
				}
			}
		},
		{
			"name": "Obtener Todos los Empleados",
			"request": {
				"method": "GET",
				"url": {
					"raw": "http://localhost:3307/employees",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3307",
					"path": ["employees"]
				},
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer <tu_token>"
					}
				]
			}
		},
		{
			"name": "Obtener Empleado por ID",
			"request": {
				"method": "GET",
				"url": {
					"raw": "http://localhost:3307/employees/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3307",
					"path": ["employees", "1"]
				},
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer <tu_token>"
					}
				]
			}
		},
		{
			"name": "Actualizar Empleado",
			"request": {
				"method": "PUT",
				"url": {
					"raw": "http://localhost:3307/employees/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3307",
					"path": ["employees", "1"]
				},
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer <tu_token>"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Juan Pérez Actualizado\",\n    \"salario\": 55000.00\n}"
				}
			}
		},
		{
			"name": "Eliminar Empleado",
			"request": {
				"method": "DELETE",
				"url": {
					"raw": "http://localhost:3307/employees/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3307",
					"path": ["employees", "1"]
				},
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer <tu_token>"
					}
				]
			}
		}
	]
}